{
  "name": "printventory",
  "version": "2.1.14",
  "description": "Printventory",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:server": "electron . --server",
    "build": "electron-builder -mw",
    "prebuild:mac": "node scripts/check-mac-dependencies.js",
    "build:mac": "node scripts/build-mac.js",
    "build:win": "node scripts/build-win.js",
    "build:linux": "node scripts/build-linux-appimage.js",
    "build:linux:internal": "electron-builder --linux --x64",
    "build:docker": "node scripts/create-docker-distribution.js",
    "docker:build": "node scripts/docker-hub-push.js build",
    "docker:tag": "node scripts/docker-hub-push.js tag",
    "docker:push": "node scripts/docker-hub-push.js push",
    "docker:push:version": "node scripts/docker-hub-push.js push-version",
    "docker:push:latest": "node scripts/docker-hub-push.js push-latest",
    "docker:hub:all": "node scripts/docker-hub-push.js all",
    "zip:macos": "powershell -ExecutionPolicy Bypass -File scripts/zip-macos-build.ps1",
    "build:mac:remote": "powershell -ExecutionPolicy Bypass -File scripts/build-mac-remote.ps1",
    "zip:github-source": "node scripts/create-github-source-zip.js",
    "publish:beta": "node scripts/publish-beta-release.js",
    "discord:latest-builds": "node scripts/publish-beta-release.js --discord-only",
    "discord:announce": "node scripts/discord-announce-beta.js",
    "postinstall": "electron-builder install-app-deps",
    "test": "playwright test",
    "test:bundle": "node bundle-keys.test.js",
    "test:full": "playwright test full-app-e2e.spec.js"
  },
  "author": "TechJeeper Designs",
  "license": "MIT",
  "build": {
    "nativeRebuilder": "legacy",
    "appId": "com.printventory.app",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "logo.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "asar": true,
      "asarUnpack": [
        "**/*.node",
        "**/node_modules/node-stream-zip/**/*",
        "scan-worker.js"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "logo.ico",
      "asar": true,
      "asarUnpack": [
        "**/*.node",
        "**/node_modules/node-stream-zip/**/*",
        "scan-worker.js"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "logo.png",
      "category": "Utility",
      "asar": true,
      "asarUnpack": [
        "**/*.node",
        "**/node_modules/node-stream-zip/**/*",
        "scan-worker.js"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Printventory",
      "uninstallDisplayName": "Printventory",
      "installerIcon": "logo.ico",
      "uninstallerIcon": "logo.ico",
      "installerHeaderIcon": "logo.ico",
      "installerSidebar": "installer-sidebar.bmp",
      "uninstallerSidebar": "installer-sidebar.bmp",
      "allowElevation": true,
      "runAfterFinish": true,
      "perMachine": true,
      "include": "installer.nsh",
      "differentialPackage": true,
      "displayLanguageSelector": true,
      "artifactName": "Printventory-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "main.js",
      "bundle-keys.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "preview-wall.css",
      "logo.png",
      "dup.png",
      "roulette.png",
      "tag.png",
      "aitagging.js",
      "thumbnail-compress.js",
      "slicer.js",
      "guide.js",
      "preview.js",
      "query-builder.js",
      "preview-3mf-worker-node.js",
      "threemf-loader-simple.js",
      "threemf-mesh-extract.js",
      "3d.png",
      "file-icon.png",
      "sidebar-bg.jpg",
      "guide/*",
      "bg.png",
      "search.js",
      "scan-worker.js",
      "parse-worker.js",
      "vendor/**",
      "vendor/**/*",
      "server-bridge.js",
      "installer.nsh",
      "node_modules/node-stream-zip/**/*"
    ],
    "directories": {
      "buildResources": ".",
      "output": "dist"
    },
    "asar": true
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.5.0",
    "testdriverai": "^7.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "tar": "^6.2.1",
    "node-abi": "^3.94.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "electron-google-analytics": "^1.0.2",
    "express": "^4.18.2",
    "fflate": "^0.8.1",
    "fs": "^0.0.1-security",
    "fuse.js": "^7.1.0",
    "jszip": "^3.10.1",
    "node-fetch": "^3.3.2",
    "node-stream-zip": "^1.15.0",
    "openai": "^6.9.1",
    "puppeteer": "^24.31.0",
    "three": "^0.181.2",
    "universal-analytics": "^0.5.3",
    "ws": "^8.14.2",
    "xmldom": "^0.6.0"
  }
}
